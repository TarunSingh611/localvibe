# =============================================================================
# LocalVibe environment variables
# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Every service below has a free tier that is enough to launch.
# =============================================================================

# --- Required ----------------------------------------------------------------

# MongoDB Atlas (free M0 cluster): https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=localvibe

# NextAuth. Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Public URL of the site (no trailing slash). Use your Vercel/custom domain in production.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (free: 25 credits/month) for photo uploads: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated emails that become moderators (admin dashboard at /admin)
ADMIN_EMAILS=you@example.com

# Public contact address shown on legal pages and sent to OpenStreetMap Nominatim
CONTACT_EMAIL=you@example.com

# --- Recommended -------------------------------------------------------------

# Resend (free: 3,000 emails/month) for password resets, welcome and alert emails.
# Without it, emails are logged to the server console instead of sent.
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own address.
EMAIL_FROM=LocalVibe <hello@yourdomain.com>

# --- Optional ----------------------------------------------------------------

# "Continue with Google" appears only when both are set.
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Custom map tiles (defaults to OpenStreetMap). Use a free provider such as
# MapTiler or Stadia Maps if your traffic grows beyond OSM's fair-use policy.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOUR_KEY
